# PantryPal — environment configuration
# Copy this file to `.env` and paste your keys. `.env` is gitignored.

# --- Required: Anthropic (the LLM) ---
ANTHROPIC_API_KEY=sk-ant-paste-your-key-here

# --- Required for web search: Tavily (the external tool) ---
# Free tier at https://tavily.com — the app still runs without it, but the
# web_search tool will return an "unavailable" message instead of results.
TAVILY_API_KEY=tvly-paste-your-key-here

# --- Optional: model + cost tuning (sensible defaults shown) ---
# Cheap/fast model for simple turns; stronger model for recipe reasoning.
PANTRYPAL_FAST_MODEL=claude-haiku-4-5
PANTRYPAL_SMART_MODEL=claude-sonnet-4-6
PANTRYPAL_MAX_TOKENS=1024
TAVILY_MAX_RESULTS=3
RECIPE_SEARCH_LIMIT=5
